#!/usr/bin/env bash

set -euo pipefail

# Always run from the Docusaurus project root: /docs
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

EXTERNAL_DIR="$PROJECT_ROOT/external"
ENV_FILE="$PROJECT_ROOT/.env.local"

mkdir -p "$EXTERNAL_DIR"

# Format:
# id|label|repository|checkout_path
#
# id must match the id used in docusaurus.config.js / DOCS_EXTERNAL
REPOS=(
  "tsc|TSC|fairpm/tsc|external/tsc"
)

USE_ALL=false

for arg in "$@"; do
  case "$arg" in
    --all)
      USE_ALL=true
      ;;
    *)
      echo "Unknown option: $arg"
      echo "Usage: npm run fair-build -- --all"
      exit 1
      ;;
  esac
done

selected_ids=()
selected_repos=()

ask_yes_no() {
  local prompt="$1"
  local answer

  while true; do
    read -r -p "$prompt [y/n]: " answer
    case "$answer" in
      [Yy]|[Yy][Ee][Ss])
        return 0
        ;;
      [Nn]|[Nn][Oo])
        return 1
        ;;
      *)
        echo "Please answer y or n."
        ;;
    esac
  done
}

clone_or_update_repo() {
  local repo="$1"
  local target_path="$2"
  local absolute_target="$PROJECT_ROOT/$target_path"

  mkdir -p "$(dirname "$absolute_target")"

  if [ -d "$absolute_target/.git" ]; then
    echo "Updating $repo in $target_path..."
    git -C "$absolute_target" pull --ff-only
  elif [ -d "$absolute_target" ]; then
    echo "ERROR: $target_path exists, but it is not a Git repository."
    echo "Remove it or move it before running this script again."
    exit 1
  else
    echo "Cloning $repo into $target_path..."
    git clone "https://github.com/$repo.git" "$absolute_target"
  fi
}

for repo_config in "${REPOS[@]}"; do
  IFS="|" read -r id label repo checkout_path <<< "$repo_config"

  if [ "$USE_ALL" = true ]; then
    selected_ids+=("$id")
    selected_repos+=("$repo_config")
  else
    if ask_yes_no "Include $label docs?"; then
      selected_ids+=("$id")
      selected_repos+=("$repo_config")
    fi
  fi
done

if [ "${#selected_ids[@]}" -eq 0 ]; then
  echo "No external docs selected."
  echo "Building only the main Docusaurus docs..."
else
  echo "Selected external docs: ${selected_ids[*]}"

  for repo_config in "${selected_repos[@]}"; do
    IFS="|" read -r id label repo checkout_path <<< "$repo_config"
    clone_or_update_repo "$repo" "$checkout_path"
  done
fi

DOCS_EXTERNAL_VALUE="$(IFS=,; echo "${selected_ids[*]}")"

cat > "$ENV_FILE" <<EOF
# Generated by scripts/fair-build.sh
DOCS_EXTERNAL=$DOCS_EXTERNAL_VALUE
EOF

echo "Updated $ENV_FILE:"
cat "$ENV_FILE"

echo "Running Docusaurus build..."

if [ -n "$DOCS_EXTERNAL_VALUE" ]; then
  DOCS_EXTERNAL="$DOCS_EXTERNAL_VALUE" npm run build
else
  npm run build
fi